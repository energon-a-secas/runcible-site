{
  "format": "neo-book/1",
  "id": "japanese",
  "version": "2026-09-08",
  "title": { "en": "Japanese", "es": "Japonés" },
  "tagline": {
    "en": "From why they say gandamu to reading a song line",
    "es": "Desde por qué dicen gandamu hasta leer una línea de canción"
  },
  "glyph": "あ",
  "lang": { "content": "ja", "ui": ["en", "es"] },
  "goal": {
    "en": "Read hiragana and katakana without romaji, and hold the first hundred words",
    "es": "Leer hiragana y katakana sin romaji, y sostener las primeras cien palabras"
  },
  "tracks": [
    {
      "id": "textbook",
      "label": { "en": "Textbook order", "es": "Orden de libro de texto" },
      "description": {
        "en": "Grammar from lesson one, kana only, kanji later. The Genki shape.",
        "es": "Gramática desde la lección uno, solo kana, kanji después. La forma de Genki."
      },
      "default": true
    },
    {
      "id": "kanji-first",
      "label": { "en": "Kanji first", "es": "Kanji primero" },
      "description": {
        "en": "Kanji and vocabulary before grammar, so grammar arrives with words in it. The Tofugu shape.",
        "es": "Kanji y vocabulario antes de la gramática, para que la gramática llegue con palabras dentro. La forma de Tofugu."
      }
    },
    {
      "id": "immersion",
      "label": { "en": "Immersion", "es": "Inmersión" },
      "description": {
        "en": "Kana, grammar and listening in the same week, reading early and often. The TheMoeWay shape.",
        "es": "Kana, gramática y escucha en la misma semana, leyendo pronto y a menudo. La forma de TheMoeWay."
      }
    }
  ],
  "chapters": [
    { "id": "0-sounds", "src": "chapters/0-sounds.json", "requires": [], "state": "ready" },
    { "id": "1-hiragana", "src": "chapters/1-hiragana.json", "requires": ["0-sounds"], "state": "ready" },
    { "id": "2-katakana", "src": "chapters/2-katakana.json", "requires": ["1-hiragana"], "state": "ready" },
    { "id": "13-writing-system", "src": "chapters/13-writing-system.json", "requires": ["2-katakana"], "state": "ready" },
    { "id": "3-songs", "src": "chapters/3-songs.json", "requires": ["1-hiragana"], "state": "ready" },
    { "id": "4-first-words", "src": "chapters/4-first-words.json", "requires": ["2-katakana"], "state": "ready" },
    { "id": "14-phrases", "src": "chapters/14-phrases.json", "requires": ["4-first-words"], "state": "ready" },
    {
      "id": "5-grammar",
      "src": "chapters/5-grammar.json",
      "requires": {
        "textbook": ["4-first-words"],
        "kanji-first": ["6-kanji"],
        "immersion": ["1-hiragana"]
      },
      "state": "ready"
    },
    { "id": "6-kanji", "src": "chapters/6-kanji.json", "requires": ["4-first-words"], "state": "ready" },
    {
      "id": "7-listening-speaking",
      "src": "chapters/7-listening-speaking.json",
      "requires": {
        "textbook": ["5-grammar"],
        "kanji-first": ["5-grammar"],
        "immersion": ["4-first-words"]
      },
      "state": "ready"
    },
    { "id": "8-study-plan", "src": "chapters/8-study-plan.json", "requires": [], "state": "ready" },
    { "id": "9-graded-reading", "src": "chapters/9-graded-reading.json", "requires": ["5-grammar"], "state": "ready" },
    { "id": "10-kanji-beyond", "src": "chapters/10-kanji-beyond.json", "requires": ["6-kanji"], "state": "ready" },
    { "id": "11-conversation", "src": "chapters/11-conversation.json", "requires": ["7-listening-speaking"], "state": "ready" },
    { "id": "12-handwriting", "src": "chapters/12-handwriting.json", "requires": ["2-katakana"], "state": "ready" }
  ],
  "modules": [
    { "path": "exercises/kana-input.js", "provides": { "transforms": ["kana", "kana-katakana"] } },
    { "path": "exercises/loanword.js", "provides": { "exercises": ["jp.loanword"] } },
